# display-mode configuration -- generated by ansible (roles/display_mode)
#
# Do not edit this file: the next `make deploy` overwrites it. The values come from
# ansible/vars/mac-mini.yml, which carries the notes on what they mean and on confirming
# them with discover.sh.

# --- display identifiers -------------------------------------------
# UUIDs from `m1ddc display list` rather than its index, which follows the connection
# order. UW is the 34WQ60C-B in front, UHD the 27US500-W to the side.
UW_ID="{{ display_mode_uw_id }}"
UHD_ID="{{ display_mode_uhd_id }}"

# --- input switching command ---------------------------------------
# "input" is the standard MCCS input source (VCP 0x60); "input-alt" is LG's own, for a
# panel that does not answer the standard one.
UW_CMD="{{ display_mode_uw_cmd }}"
UHD_CMD="{{ display_mode_uhd_cmd }}"

# --- input source values -------------------------------------------
# MINI is HDMI 1, where the Mac mini is; DOCK is DP, where the CalDigit dock is.
UW_MINI={{ display_mode_uw_mini }}
UW_DOCK={{ display_mode_uw_dock }}
UHD_MINI={{ display_mode_uhd_mini }}
UHD_DOCK={{ display_mode_uhd_dock }}
